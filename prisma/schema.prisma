generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([email])
}

model ChatMessage {
  id        String   @id @default(cuid())
  author    String
  content   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
